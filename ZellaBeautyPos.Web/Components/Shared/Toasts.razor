@implements IDisposable
@inject ToastService Toast

<div class="toasts" aria-live="polite">
    @foreach (var t in Toast.Items.ToList())
    {
        <div class="toast @(t.IsError ? "toast-error" : "")" @key="t.Id" role="status">
            <span class="toast-dot"></span>
            <span>@t.Message</span>
            <button class="toast-x" aria-label="Dismiss" @onclick="() => Toast.Dismiss(t.Id)">×</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toast.Changed += OnChanged;
    void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Toast.Changed -= OnChanged;
}
